# Discovery
DISCOVERY_PORT=8761

# Gateway
GATEWAY_PORT=8080
EUREKA_SERVER_URL=http://discovery-service:8761/eureka/
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://discovery-service:8761/eureka/

# Auth DB
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass
AUTH_DB_ROOT_PASSWORD=root
AUTH_DB_PORT=3307

# Optional local demonstration account (never enable with shared production credentials)
EDGECLOUD_DEMO_ACCOUNT_ENABLED=true
EDGECLOUD_DEMO_ACCOUNT_EMAIL=dashboard.admin@edgecloud.com
EDGECLOUD_DEMO_ACCOUNT_PASSWORD=Password123!
EDGECLOUD_DEMO_ACCOUNT_ROLE=ADMIN

# Monitoring DB
MONITORING_DB_NAME=monitoring_db
MONITORING_DB_USER=monitoring_user
MONITORING_DB_PASSWORD=monitoring_pass
MONITORING_DB_ROOT_PASSWORD=root
MONITORING_DB_PORT=3308

# Device DB
DEVICE_DB_NAME=device_db
DEVICE_DB_USER=device_user
DEVICE_DB_PASSWORD=device_pass
DEVICE_DB_ROOT_PASSWORD=root
DEVICE_DB_PORT=3309

# Alert DB
ALERT_DB_NAME=alert_db
ALERT_DB_USER=alert_user
ALERT_DB_PASSWORD=alert_pass
ALERT_DB_ROOT_PASSWORD=root
ALERT_DB_PORT=3310

# Project DB
PROJECT_DB_NAME=project_db
PROJECT_DB_USER=project_user
PROJECT_DB_PASSWORD=project_pass
PROJECT_DB_ROOT_PASSWORD=root
PROJECT_DB_PORT=3311

# Notification DB
NOTIFICATION_DB_NAME=notificationdb
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=notification_pass
NOTIFICATION_DB_ROOT_PASSWORD=root
NOTIFICATION_DB_PORT=3312

# Shared internal service authentication (local development only)
EDGECLOUD_INTERNAL_SERVICE_KEY=replace-with-a-local-development-key
